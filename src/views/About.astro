---
import { Image } from 'astro:assets';
import profile from '../assets/images/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blob from '../components/Blob.astro';
import Lens from '../components/Lens.astro';
import DotGrid from '../components/DotGrid.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { disciplines } from '../data/disciplines';
import { projectCountBy } from '../data/projects';
import { certifications, experience, formatPeriod, languages, location, tools } from '../data/site';
import { getLang, localizePath, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={t('about.meta')} description={t('about.lead')} current="about">
  <section class="container ab-hero">
    <div class="ab-hero__copy">
      <p class="label">{t('about.label')}</p>
      <h1><span>Luiti</span><span>Escobar</span></h1>
      <p class="ab-hero__role">{t('about.role')} · {location[lang]}</p>
      <p class="ab-hero__lead">{t('about.lead')}</p>
    </div>
    <div class="ab-hero__art">
      <Blob class="ab-blob-a" from="#00ff99" to="#3a6bff" blur={34} opacity={0.8} />
      <Blob class="ab-blob-b" from="#ff3c3c" to="#ff8a3c" />
      <Image class="ab-hero__photo" src={profile} alt="Luiti Escobar" widths={[360, 540, 720]} sizes="(min-width: 1024px) 420px, 80vw" loading="eager" />
      <Lens class="ab-lens" />
      <DotGrid class="ab-dots" />
    </div>
  </section>

  <section class="container row">
    <h2 class="label">{t('about.bio')}</h2>
    <div class="bio">
      <p>{t('intro.p1')}</p>
      <p>{t('intro.p2')}</p>
    </div>
  </section>

  <section class="container row">
    <h2 class="label">{t('about.disciplines')}</h2>
    <ul class="disc">
      {disciplines.map((d, i) => (
        <li>
          <a href={localizePath(`/${d.slug}`, lang)} style={`--c:${d.colors[1]}`}>
            <span class="label">{pad(i + 1)}</span>
            <span class="disc__name">{d.name[lang]}</span>
            <span class="disc__subs">{d.subcategories.map((s) => s.label[lang]).join(' · ')}</span>
            <span class="disc__count label">{projectCountBy(d.id)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container row">
    <h2 class="label">{t('about.experience')}</h2>
    <ol class="exp">
      {experience.map((e) => (
        <li>
          <span class="label">{formatPeriod(e, lang)}</span>
          <div class="exp__main">
            <strong>{e.company}</strong>
            <span class="exp__role">{e.role[lang]} · {e.place[lang]}</span>
            <p>{e.summary[lang]}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container row">
    <h2 class="label">{t('about.tools')}</h2>
    <ul class="tools">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <section class="container row">
    <h2 class="label">{t('about.training')}</h2>
    <div>
      <p class="training__intro">{t('about.selftaught')}</p>
      <ul class="list">
        {certifications.map((c) => (
          <li><span>{c.title}</span>{c.detail && <span class="list__meta">{c.detail[lang]}</span>}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container row">
    <h2 class="label">{t('about.languages')}</h2>
    <ul class="list">
      {languages.map((l) => <li><span>{l.name[lang]}</span><span class="list__meta">{l.level[lang]}</span></li>)}
    </ul>
  </section>

  <div class="cta"><ContactStrip /></div>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .ab-hero { display: grid; gap: 40px; padding-top: 32px; }
  .ab-hero .label { margin-bottom: 18px; }
  h1 { display: flex; flex-direction: column; font-size: clamp(60px, 18vw, 140px); font-weight: 200; line-height: .9; letter-spacing: -.035em; text-transform: uppercase; }
  h1 span + span { font-weight: 400; }
  .ab-hero__role { margin-top: 18px; font-size: 17px; color: var(--ink-2); }
  .ab-hero__lead { margin-top: 24px; max-width: 560px; font-size: 22px; font-weight: 200; line-height: 1.35; }

  .ab-hero__art { position: relative; justify-self: end; width: min(78%, 420px); }
  .ab-hero__art :global(.ab-hero__photo) {
    position: relative; z-index: 1; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%;
    border-radius: 10px 10px 10px 50% / 10px 10px 10px 40%;
  }
  .ab-hero__art :global(.ab-blob-a) { width: 46%; height: auto; aspect-ratio: 1; left: -30%; top: -8%; z-index: 0; }
  .ab-hero__art :global(.ab-blob-b) { width: 80%; height: auto; aspect-ratio: 420 / 460; right: -42%; bottom: 6%; z-index: 0; }
  .ab-hero__art :global(.ab-lens) { width: 44%; right: -16%; bottom: 22%; z-index: 2; }
  .ab-hero__art :global(.ab-dots) { width: 30%; left: -14%; bottom: -8%; transform: rotate(45deg); z-index: 2; }

  /* ---------- content rows ---------- */
  .row { display: grid; gap: 18px; padding: 32px 0; border-top: 1px solid var(--line); }
  .ab-hero + .row { margin-top: 72px; }
  .bio p { font-size: 21px; font-weight: 200; line-height: 1.4; }
  .bio p + p { margin-top: 1em; }

  .disc, .exp, .tools { list-style: none; }
  .disc a {
    display: grid; grid-template-columns: 32px 1fr auto; align-items: baseline; column-gap: 12px;
    padding: 16px 0; border-bottom: 1px solid var(--line);
  }
  .disc li:first-child a { padding-top: 0; }
  .disc__name { font-size: 28px; font-weight: 200; letter-spacing: -.01em; transition: color .25s; position: relative; }
  .disc__name::after {
    content: ""; display: inline-block; width: 10px; height: 10px; margin-left: 12px; border-radius: 50%;
    background: var(--c); vertical-align: middle; transform: scale(0); transition: transform .3s var(--ease);
  }
  .disc a:hover .disc__name::after { transform: scale(1); }
  .disc__subs { grid-column: 2 / -1; font-size: 13px; color: var(--muted); margin-top: 4px; }
  .disc__count { grid-row: 1; grid-column: 3; }

  .exp li { display: grid; gap: 6px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .exp li:first-child { padding-top: 0; }
  .exp__main { display: grid; gap: 4px; }
  .exp strong { font-size: 20px; font-weight: 400; }
  .exp__role { font-size: 14px; color: var(--ink-2); }
  .exp p { margin-top: 6px; font-size: 15px; line-height: 1.55; color: var(--ink-2); max-width: 620px; }

  .training__intro { margin-bottom: 16px; font-size: 17px; color: var(--ink-2); max-width: 620px; }
  .list { list-style: none; }
  .list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .list__meta { font-family: var(--mono); font-size: 12px; color: var(--muted); }

  .tools { display: flex; flex-wrap: wrap; gap: 8px; }
  .tools li { padding: 7px 14px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); font-size: 14px; }

  .cta { margin-top: 72px; }

  @media (min-width: 1024px) {
    .ab-hero { grid-template-columns: 1fr 420px; align-items: center; gap: 80px; padding-top: 24px; min-height: 560px; }
    .ab-hero__art { width: 100%; justify-self: stretch; }
    .ab-hero__role { font-size: 22px; }
    .ab-hero__lead { font-size: 28px; line-height: 1.3; }

    .row { grid-template-columns: 35.17% 1fr; gap: 0; padding: 48px 0; }
    .ab-hero + .row { margin-top: 120px; }
    .row .label { padding-top: 10px; }
    .bio p { font-size: 28px; line-height: 1.3; max-width: 778px; }

    .disc a { grid-template-columns: 48px 1fr 280px 40px; padding: 22px 0; }
    .disc__name { font-size: 40px; }
    .disc__subs { grid-column: 3; margin: 0; font-size: 14px; }
    .disc__count { grid-column: 4; text-align: right; }

    .exp li { grid-template-columns: 200px 1fr; align-items: baseline; padding: 24px 0; }
    .exp strong { font-size: 24px; font-weight: 300; }
    .exp p { font-size: 16px; }
    .training__intro { font-size: 20px; }

    .cta { margin-top: 120px; }
  }
</style>
