---
import BaseLayout from '../layouts/BaseLayout.astro';
import Blob from '../components/Blob.astro';
import RichBody from '../components/RichBody.astro';
import CoverMedia from '../components/CoverMedia.astro';
import Reel from '../components/Reel.astro';
import { imageAttrs } from '../lib/sanity';
import ProjectActions from '../components/ProjectActions.astro';
import MasonryGrid from '../components/MasonryGrid.astro';
import { disciplineById } from '../data/disciplines';
import { projectsFor, type Project } from '../data/projects';
import { getCaseStudy, pageTitle } from '../data/caseStudies';
import { getLang, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const d = disciplineById[p.discipline];
const cs = getCaseStudy(p, lang);
const title = pageTitle(p, lang);
const sub = d.subcategories.find((s) => s.id === p.subcategory);

// prev / next within the same discipline, wrapping around
const siblings = projectsFor(d.id);
const i = siblings.findIndex((s) => s.slug === p.slug);
const prev = siblings[(i - 1 + siblings.length) % siblings.length];
const next = siblings[(i + 1) % siblings.length];
const more = siblings.filter((s) => s.slug !== p.slug).slice(0, 6);

const facts = [
  [t('project.client'), cs.client],
  [t('project.year'), cs.year],
  [t('project.role'), cs.role],
  [t('project.tools'), cs.tools],
].filter(([, v]) => v);
// motion pieces show their video on top; the cover stays the poster and the gallery thumbnail
const video = p.source?.video;
const poster = imageAttrs(p.image, 1920);
const gradient = (c: [string, string]) => `linear-gradient(135deg, ${c[0]}, ${c[1]})`;
---

<BaseLayout title={`${title} — Luiti Escobar`} description={cs.lead} current={d.id}>
  <article class="project" style={`--accent:${d.colors[1]}`}>
    <header class="container p-head">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a href={localizePath(`/${d.slug}`, lang)}>{d.word[lang].join(' ')}</a>
        {sub && <><span aria-hidden="true">/</span><span>{sub.label[lang]}</span></>}
      </nav>
      <h1>{title}</h1>
      <p class="lead">{cs.lead}</p>
      {facts.length > 0 && <dl class="facts">
        {facts.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
      </dl>}
    </header>

    <div class="container cover">
      <Blob class="cover__blob" from={d.colors[0]} to={d.colors[1]} blur={50} opacity={0.55} />
      {video ? (
        <Reel title={title} src={video} poster={poster?.src} aspect={poster && poster.aspect > 1.2 ? poster.aspect : 16 / 9} showTag={false} />
      ) : (
        <CoverMedia class="cover__img" image={p.image} gradient={p.cover} aspect={16 / 9} alt={title} sizes="(min-width: 1264px) 1200px, 100vw" eager />
      )}
    </div>

    <div class="container p-body">
      <div class="p-body__article">
        <RichBody blocks={cs.body} portable={cs.portable} />
      </div>
      <aside class="p-body__rail">
        <ProjectActions slug={p.slug} likes={p.likes} title={title} />
      </aside>
    </div>

    {cs.gallery?.map((img) => (
      <div class="container closing">
        <CoverMedia image={img} sizes="(min-width: 1264px) 1200px, 100vw" />
      </div>
    ))}

    {cs.closing && (
      <div class="container closing">
        <div role="img" aria-label={cs.closing.alt} style={`aspect-ratio:${cs.closing.aspect};background:${gradient(cs.closing.cover)}`}></div>
      </div>
    )}

    {siblings.length > 1 && <nav class="container nextprev" aria-label={`${t('project.prev')} / ${t('project.next')}`}>
      {[[prev, t('project.prev'), 'prev'], [next, t('project.next'), 'next']].map(([s, label, dir]) => {
        const item = s as Project;
        return (
          <a class:list={['np', `np--${dir}`]} href={localizePath(`/work/${item.slug}`, lang)} rel={dir as string}>
            <span class="np__thumb"><CoverMedia image={item.image} gradient={item.cover} alt="" sizes="120px" fill /></span>
            <span class="np__text">
              <span class="label">{dir === 'prev' ? `← ${label}` : `${label} →`}</span>
              <strong>{pageTitle(item, lang)}</strong>
            </span>
          </a>
        );
      })}
    </nav>}

    {more.length > 0 && <section class="container more">
      <h2 class="section-title">{t('project.more')} {d.word[lang].join(' ')}</h2>
      <MasonryGrid projects={more} />
    </section>}
  </article>
</BaseLayout>

<style>
  /* ---------- header ---------- */
  .p-head { padding-top: 32px; }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; font-size: 11px; }
  .crumbs a { transition: color .2s; }
  .crumbs a:hover { color: var(--ink); }
  h1 { font-size: clamp(40px, 6.7vw, 96px); font-weight: 200; line-height: .98; letter-spacing: -.035em; max-width: 920px; text-wrap: balance; }
  .lead { margin-top: 18px; max-width: 640px; font-size: 17px; line-height: 1.5; color: var(--ink-2); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--line); }
  .facts dd { margin-top: 6px; font-size: 15px; font-weight: 400; }

  /* ---------- cover ---------- */
  .cover { position: relative; margin-top: 36px; }
  .cover :global(.cover__blob) { width: 200px; height: 200px; right: -70px; top: -50px; }
  .cover :global(.cover__img) { position: relative; border-radius: 18px; }

  /* ---------- body ---------- */
  .p-body { margin-top: 48px; }
  .closing { margin-top: 16px; }
  .closing > :global(*) { border-radius: 18px; }

  /* ---------- next / prev ---------- */
  .nextprev { display: grid; gap: 12px; margin-top: 72px; }
  .np {
    display: flex; align-items: center; gap: 16px; padding: 14px;
    border-radius: 18px; border: 1px solid var(--line); background: var(--surface);
    transition: border-color .25s, transform .4s var(--ease);
  }
  .np:hover { border-color: var(--ink); transform: translateY(-2px); }
  .np__thumb { flex: none; width: 88px; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; }
  .np__text { display: grid; gap: 4px; min-width: 0; }
  .np strong { font-size: 18px; font-weight: 300; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .np--next { flex-direction: row-reverse; text-align: right; }

  .more { margin-top: 80px; }
  .more h2 { margin-bottom: 24px; }

  @media (min-width: 768px) {
    .crumbs { font-size: 12px; margin-bottom: 28px; }
    .lead { margin-top: 24px; font-size: 20px; }
    .facts { grid-template-columns: repeat(4, 1fr); margin-top: 48px; padding-top: 24px; }
    .facts dd { font-size: 16px; }
    .cover { margin-top: 56px; }
    .cover :global(.cover__blob) { width: 360px; height: 360px; right: -90px; top: 48px; }
    .cover :global(.cover__img), .closing > :global(*) { border-radius: 28px; }
    .closing { margin-top: 64px; }
    .nextprev { grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 120px; }
    .np { padding: 18px; gap: 20px; border-radius: 22px; }
    .np__thumb { width: 120px; }
    .np strong { font-size: 22px; }
    .more { margin-top: 120px; }
    .more h2 { margin-bottom: 32px; }
  }

  /* desktop: centered 760px article with the like rail on the right (Figma: Project — Case study) */
  @media (min-width: 1024px) {
    .p-head { padding-top: 0; }
    .p-body { display: grid; grid-template-columns: 1fr min(760px, 100%) 1fr; margin-top: 90px; }
    .p-body__article { grid-column: 2; }
    .p-body__rail { grid-column: 3; justify-self: end; }
  }
</style>
