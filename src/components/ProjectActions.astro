---
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  slug: string;
  likes: number;
  title: string;
}

const { slug, likes, title } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!--
  Like + share. Sticky rail beside the article on desktop, floating pill on mobile.
  Likes are remembered per browser for now; the shared counter arrives with the backend (Cloudflare D1).
-->
<div class="actions" data-actions data-slug={slug} data-likes={likes} data-copied={t('share.copied')}>
  <button class="actions__like" type="button" aria-pressed="false" aria-label={t('like.label')}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 10v11H3V10h4Zm0 0 4-8c1.7 0 3 1.3 3 3v4h5.5a2 2 0 0 1 2 2.3l-1.4 8A2 2 0 0 1 18.1 21H7" /></svg>
  </button>
  <span class="actions__count" aria-live="polite">{likes}</span>
  <button class="actions__share" type="button" aria-label={t('share.label')} data-title={title}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
  </button>
  <span class="actions__toast" role="status"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-actions]').forEach((root) => {
    const key = `liked:${root.dataset.slug}`;
    const base = Number(root.dataset.likes);
    const like = root.querySelector<HTMLButtonElement>('.actions__like')!;
    const count = root.querySelector<HTMLElement>('.actions__count')!;
    const toast = root.querySelector<HTMLElement>('.actions__toast')!;

    const read = () => { try { return localStorage.getItem(key) === '1'; } catch { return false; } };
    const write = (v: boolean) => { try { v ? localStorage.setItem(key, '1') : localStorage.removeItem(key); } catch { /* storage unavailable */ } };
    const render = (liked: boolean) => {
      like.setAttribute('aria-pressed', String(liked));
      count.textContent = String(base + (liked ? 1 : 0));
    };

    render(read());
    like.addEventListener('click', () => {
      const liked = like.getAttribute('aria-pressed') !== 'true';
      write(liked);
      render(liked);
      if (liked) {
        like.classList.remove('pop');
        void like.offsetWidth; // restart the animation
        like.classList.add('pop');
      }
    });

    const share = root.querySelector<HTMLButtonElement>('.actions__share')!;
    share.addEventListener('click', async () => {
      const data = { title: share.dataset.title, url: location.href };
      if (navigator.share) {
        try { await navigator.share(data); } catch { /* dismissed */ }
        return;
      }
      try {
        await navigator.clipboard.writeText(location.href);
        toast.textContent = root.dataset.copied ?? '';
        setTimeout(() => (toast.textContent = ''), 2000);
      } catch { /* clipboard blocked */ }
    });
  });
</script>

<style>
  /* mobile: floating pill */
  .actions {
    position: fixed; right: 16px; bottom: 16px; z-index: 40;
    display: flex; align-items: center; gap: 4px; padding: 6px;
    border-radius: 99px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px -20px rgb(20 20 20 / .3);
  }
  button { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; transition: background .25s, color .25s, transform .25s var(--ease); }
  .actions__like { background: var(--accent); color: #fff; box-shadow: 0 12px 26px -12px var(--accent); }
  .actions__like:hover { transform: scale(1.05); }
  .actions__like[aria-pressed='true'] svg { fill: currentColor; }
  .actions__like.pop { animation: pop .45s var(--ease); }
  .actions__count { min-width: 32px; padding-right: 4px; font-family: var(--mono); font-size: 12px; color: var(--ink-2); text-align: center; }
  .actions__share { border: 1px solid var(--line); background: var(--surface); }
  .actions__share:hover { border-color: var(--ink); }
  .actions__toast {
    position: absolute; right: 0; bottom: calc(100% + 10px); white-space: nowrap;
    padding: 6px 12px; border-radius: 99px; background: var(--ink); color: var(--bg);
    font-family: var(--mono); font-size: 11px;
  }
  .actions__toast:empty { display: none; }

  @keyframes pop { 40% { transform: scale(1.2); } 100% { transform: scale(1); } }

  /* desktop: sticky vertical rail (Figma: Appreciate rail) */
  @media (min-width: 1024px) {
    .actions {
      position: sticky; top: 120px; right: auto; bottom: auto;
      flex-direction: column; gap: 12px; padding: 0;
      border: 0; background: none; backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: none;
    }
    button { width: 56px; height: 56px; }
    .actions__count { padding: 0; }
    .actions__toast { right: auto; left: 50%; bottom: auto; top: calc(100% + 10px); translate: -50% 0; }
  }
</style>
