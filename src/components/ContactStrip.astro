---
import Blob from './Blob.astro';
import { getLang, localizePath, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const email = 'hello@luitiescobar.com';
---

<section class="container">
  <div class="contact">
    <Blob class="contact__blob-a" from="var(--ai-a)" to="var(--ai-b)" blur={60} opacity={0.55} />
    <Blob class="contact__blob-b" from="var(--motion-a)" to="var(--motion-b)" blur={60} opacity={0.5} />
    <h2>{t('contact.title.1')}<br />{t('contact.title.2')}</h2>
    <p>{t('contact.text')}</p>
    <div class="contact__actions">
      <a class="btn btn--solid" href={`mailto:${email}`}>{email}</a>
      <a class="btn" href={localizePath('/contact', lang)}>{t('contact.form')}</a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative; overflow: hidden; isolation: isolate;
    padding: 40px 24px; border-radius: 24px; text-align: center;
    background: var(--surface); border: 1px solid var(--line);
  }
  .contact :global(.contact__blob-a) { z-index: -1; width: 200px; height: 200px; left: -60px; top: -50px; }
  .contact :global(.contact__blob-b) { z-index: -1; width: 220px; height: 220px; right: -70px; bottom: -80px; }

  h2 { font-size: clamp(40px, 6.4vw, 92px); font-weight: 200; line-height: 1; letter-spacing: -.03em; }
  p { margin: 16px auto 24px; max-width: 460px; font-size: 15px; color: var(--ink-2); }

  .contact__actions { display: grid; gap: 12px; }
  .btn {
    display: inline-flex; justify-content: center; align-items: center;
    padding: 12px 22px; border-radius: 99px; border: 1px solid var(--ink);
    font-size: 15px; font-weight: 400; transition: background .25s, color .25s;
  }
  .btn:hover { background: var(--ink); color: var(--bg); }
  .btn--solid { background: var(--ink); color: var(--bg); }
  .btn--solid:hover { background: transparent; color: var(--ink); }

  @media (min-width: 768px) {
    .contact { padding: 81px 24px; border-radius: 32px; }
    .contact :global(.contact__blob-a) { width: 340px; height: 300px; left: -140px; top: -127px; }
    .contact :global(.contact__blob-b) { width: 467px; height: 467px; right: -130px; bottom: -170px; }
    p { margin: 22px auto 36px; font-size: 17px; }
    .contact__actions { display: flex; justify-content: center; }
  }
</style>
