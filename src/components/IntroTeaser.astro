---
import { getLang, localizePath, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="container intro">
  <p class="label">{t('intro.label')}</p>
  <div class="intro__body">
    <p>{t('intro.p1')}</p>
    <p class="intro__extra">{t('intro.p2')}</p>
    <a class="arrow-link" href={localizePath('/about', lang)}>{t('intro.more')} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .intro { padding: 28px 0 72px; border-top: 1px solid var(--line); margin-top: 56px; }
  .intro .label { margin-bottom: 14px; }
  .intro__body p { font-size: 21px; font-weight: 200; line-height: 1.35; letter-spacing: -.005em; }
  .intro__extra { display: none; }
  .arrow-link { margin-top: 20px; font-size: 15px; }

  @media (min-width: 1024px) {
    .intro { display: grid; grid-template-columns: 35.17% 1fr; padding: 60px 0 100px; border-top: 0; margin-top: 0; }
    .intro .label { margin: 10px 0 0; }
    .intro__body { padding-top: 0; }
    .intro__body p { font-size: 28px; line-height: 1.3; max-width: 778px; }
    .intro__body p + p { margin-top: 1.1em; }
    .intro__extra { display: block; }
    .arrow-link { margin-top: 28px; font-size: 16px; }
  }
</style>
