---
/** Frosted-glass circle that magnifies/blurs whatever sits behind it. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['lens', className]} aria-hidden="true"><slot /></div>

<style>
  .lens {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / .28);
    border: 1px solid rgb(255 255 255 / .7);
    backdrop-filter: blur(22px) saturate(1.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.4);
    box-shadow: 0 30px 60px -20px rgb(20 20 20 / .16), inset 0 1px 0 rgb(255 255 255 / .8);
  }
</style>
