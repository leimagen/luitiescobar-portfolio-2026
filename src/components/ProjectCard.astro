---
import CoverMedia from './CoverMedia.astro';
import type { Project } from '../data/projects';
import { pageTitle } from '../data/caseStudies';
import { getLang, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<a
  class="card"
  href={localizePath(`/work/${p.slug}`, lang)}
  data-sub={p.subcategory}
  data-date={p.date}
  data-likes={p.likes}
  data-aspect={p.aspect}
>
  <div class="card__media">
    <CoverMedia class="card__cover" image={p.image} gradient={p.cover} aspect={p.aspect} alt={pageTitle(p, lang)} sizes="(min-width: 1100px) 285px, (min-width: 768px) 33vw, 50vw" />
  </div>
  <div class="card__meta">
    <h3>{pageTitle(p, lang)}</h3>
    <span class="card__likes">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 10v11H3V10h4Zm0 0 4-8c1.7 0 3 1.3 3 3v4h5.5a2 2 0 0 1 2 2.3l-1.4 8A2 2 0 0 1 18.1 21H7" /></svg>
      <span data-like-count={p.slug}>{p.likes}</span><span class="visually-hidden"> {t('work.likes')}</span>
    </span>
  </div>
</a>

<style>
  .card { display: block; break-inside: avoid; margin-bottom: 20px; }
  .card[hidden] { display: none; }
  .card__media { border-radius: 14px; overflow: hidden; background: #eceae4; }
  .card__media :global(.card__cover) { transition: transform .6s var(--ease); }
  .card:hover :global(.card__cover) { transform: scale(1.035); }

  .card__meta { display: flex; align-items: baseline; gap: 8px; padding: 10px 2px 0; }
  .card__meta h3 { flex: 1; min-width: 0; font-size: 14px; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card__likes { display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono); font-size: 11px; color: var(--muted); }

  @media (min-width: 768px) {
    .card { margin-bottom: 26px; }
    .card__media { border-radius: 18px; }
    .card__meta { padding: 12px 4px 0; }
    .card__meta h3 { font-size: 15px; }
    .card__likes { font-size: 12px; gap: 6px; }
  }
</style>
