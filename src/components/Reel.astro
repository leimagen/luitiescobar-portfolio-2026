---
import Lens from './Lens.astro';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  /** Vimeo / YouTube link or a direct video file. Without it the reel shows a "coming soon" note. */
  src?: string;
  /** image shown before playing (and as the <video> poster) */
  poster?: string;
  /** width / height; defaults to 16:9 */
  aspect?: number;
  /** small title label in the corner */
  showTag?: boolean;
}

const { title, src, poster, aspect, showTag = true } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// privacy-friendly embeds, loaded only after the visitor presses play
function embedUrl(url?: string) {
  if (!url) return undefined;
  const yt = url.match(/(?:youtu\.be\/|[?&]v=|shorts\/|embed\/)([\w-]{11})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0&modestbranding=1`;
  const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/([0-9a-f]{6,}))?/);
  if (vimeo) {
    // unlisted videos carry a privacy hash: vimeo.com/ID/HASH or ?h=HASH
    const hash = vimeo[2] ?? url.match(/[?&]h=([0-9a-f]+)/)?.[1];
    return `https://player.vimeo.com/video/${vimeo[1]}?autoplay=1&dnt=1&title=0&byline=0&portrait=0${hash ? `&h=${hash}` : ''}`;
  }
  return undefined;
}
const embed = embedUrl(src);
const file = src && !embed ? src : undefined;
---

<figure
  class:list={['reel', { 'has-poster': poster }]}
  data-reel
  data-embed={embed}
  data-title={title}
  style={[aspect ? `aspect-ratio:${aspect}` : '', poster ? `background-image:url(${poster})` : ''].filter(Boolean).join(';')}
>
  {file && <video src={file} poster={poster} preload="none" playsinline aria-label={title}></video>}

  <div class="reel__poster">
    {showTag && <span class="reel__tag">{title}</span>}
    <button class="reel__play" type="button" disabled={!src} aria-label={src ? `${t('reel.play')}: ${title}` : t('reel.soon')}>
      <Lens class="reel__lens" />
      <span class="reel__content">
        <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M0 0L12 7L0 14Z" fill="currentColor" /></svg>
        <span class="reel__label">{src ? t('reel.play') : t('reel.soon')}</span>
      </span>
    </button>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const play = reel.querySelector<HTMLButtonElement>('.reel__play');
    if (!play || play.disabled) return;
    play.addEventListener('click', () => {
      const video = reel.querySelector('video');
      if (reel.dataset.embed) {
        const frame = document.createElement('iframe');
        frame.src = reel.dataset.embed;
        frame.title = reel.dataset.title ?? '';
        frame.allow = 'autoplay; fullscreen; picture-in-picture';
        frame.allowFullscreen = true;
        reel.prepend(frame);
      } else if (video) {
        video.controls = true;
        video.play();
      }
      reel.classList.add('is-playing');
    });
  });
</script>

<style>
  .reel {
    position: relative; z-index: 1; overflow: hidden;
    aspect-ratio: 16 / 9; border-radius: 18px;
    background: linear-gradient(140deg, #4fe0ff 0%, var(--motion-b) 45%, #0f1a3a 100%);
  }
  .reel.has-poster { background-size: cover; background-position: center; }
  .reel.has-poster .reel__poster { background: linear-gradient(transparent 55%, rgb(0 0 0 / .25)); }
  video, .reel :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }

  .reel__poster { position: absolute; inset: 0; transition: opacity .4s var(--ease); }
  .reel.is-playing .reel__poster { opacity: 0; pointer-events: none; }

  .reel__tag {
    position: absolute; left: 14px; top: 12px;
    font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: #fff;
  }

  .reel__play {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    display: grid; place-items: center; width: 64px; aspect-ratio: 1; color: #fff;
    transition: scale .4s var(--ease);
  }
  .reel__play:not(:disabled):hover { scale: 1.06; }
  .reel__play:disabled { cursor: default; }
  .reel__play :global(.reel__lens) { inset: 0; width: 100%; }
  .reel__content { position: relative; display: flex; align-items: center; gap: 8px; translate: 2px 0; }
  .reel__label {
    font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap;
  }
  /* mobile: icon only; "coming soon" caption sits under the lens */
  .reel__play:not(:disabled) .reel__label { display: none; }
  .reel__play:disabled .reel__label { position: absolute; left: 50%; top: calc(100% + 30px); translate: -50% 0; }

  @media (min-width: 768px) {
    .reel { border-radius: 28px; }
    .reel__tag { left: 28px; top: 24px; font-size: 12px; }
    .reel__play { width: 128px; }
    .reel__play:not(:disabled) .reel__label { display: inline; font-size: 13px; letter-spacing: .3em; }
    /* "Reproducir" is twice as long as "Play": tighter tracking keeps it inside the lens */
    .reel__play:not(:disabled) .reel__label:lang(es) { font-size: 12px; letter-spacing: .12em; }
    .reel__play:disabled .reel__label { top: calc(100% + 56px); font-size: 12px; }
  }
</style>
