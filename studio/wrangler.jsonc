{
  // Sanity Studio served as static assets at cms.luitiescobar.com.
  // Access is protected by Sanity login: only members of the Sanity project can edit.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luitiescobar-cms",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "cms.luitiescobar.com", "custom_domain": true }]
}
