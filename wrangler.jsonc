{
  // Portfolio site: prerendered pages served as static assets + /api/likes on the Worker.
  // `main` and `assets` are filled in by @astrojs/cloudflare at build time (dist/server/wrangler.json).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luitiescobar",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luitiescobar-likes",
      "database_id": "c9b2180e-c9e1-4c22-b3fd-65a4e78272a3",
      "migrations_dir": "migrations"
    }
  ],
  // Contact form email. No fixed destination here (public repo): the Worker secret CONTACT_TO holds it,
  // and it must be a verified Email Routing destination.
  "send_email": [{ "name": "EMAIL" }],
  // Live on the main domain since 2026-10-17 (replaced the old Cloudflare Pages site "luitiescobar").
  // workers.dev stays on as a secondary preview URL.
  "workers_dev": true,
  "routes": [
    // www.luitiescobar.com belongs to workers/www-redirect (301 to the apex)
    { "pattern": "luitiescobar.com", "custom_domain": true }
  ]
}
